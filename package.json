{
  "name": "edensoft-client",
  "version": "1.0.0",
  "description": "Windows client สำหรับ สุริยันต์ดับดารา (play.edensoft.net) พร้อม PiP และซ่อนลงถาดระบบ",
  "main": "main.js",
  "author": "you",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "net.edensoft.client",
    "productName": "Surisan Client",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "bar.html", "donate.html", "donate.png", "icon.png"],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
